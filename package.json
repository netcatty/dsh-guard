{
  "name": "dsh-guard",
  "version": "0.1.2",
  "description": "allow/ask/deny permission gates for DeepSeek Harness tools: path surfaces, per-tool rules, bash patterns, redaction, session approvals, fail-closed config",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/shell.js",
    "lib/mask.js",
    "cordis.patch.yml",
    "policy.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./mask": {
      "default": "./lib/mask.js"
    }
  },
  "author": "netcatty",
  "repository": {
    "type": "git",
    "url": "https://github.com/netcatty/dsh-guard.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "permissions",
    "guard",
    "security"
  ]
}
