{
  "name": "dsh-guard",
  "version": "1.0.0",
  "description": "allow/ask/deny permission gates for DeepSeek Harness tools: path/params/agents surfaces, argv decomposition, network rules, redaction, grants, dry-run, fail-closed config",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/shell.js",
    "lib/mask.js",
    "lib/paths.js",
    "lib/match.js",
    "lib/params.js",
    "lib/snapshots.js",
    "lib/jsonc.js",
    "lib/preview.js",
    "cordis.patch.yml",
    "policy.json",
    "policy.schema.json",
    "README.md",
    "lib/policy-edit.js",
    "lib/presets.js",
    "lib/client.js",
    "lib/audit-log.js",
    "lib/diff-view.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./mask": {
      "default": "./lib/mask.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "author": "netcatty",
  "repository": {
    "type": "git",
    "url": "https://github.com/netcatty/dsh-guard.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "permissions",
    "guard",
    "security"
  ],
  "scripts": {
    "test": "node --test test/guard.test.mjs test/features.test.mjs test/snapshots.test.mjs test/audit-log.test.mjs test/diff-view.test.mjs"
  }
}
